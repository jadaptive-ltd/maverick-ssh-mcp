<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jadaptive</groupId>
    <artifactId>maverick-ssh-mcp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Maverick SSH MCP Server</name>
    <description>MCP server for Maverick Synergy SSH workflows</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <mcp.version>2.0.0</mcp.version>
        <picocli.version>4.7.6</picocli.version>
        <maverick.version>3.2.0-SNAPSHOT</maverick.version>
        <jetty.version>11.0.26</jetty.version>
        <junit.version>5.11.4</junit.version>
        <native.maven.plugin.version>0.10.5</native.maven.plugin.version>
        <build.number>0</build.number>
        <athene.sign.url></athene.sign.url>
        <athene.api></athene.api>
        <athene.repo></athene.repo>
        <athene.serverId></athene.serverId>
        <athene.macos.sign.key></athene.macos.sign.key>
        <athene.macos.sign.passphrase></athene.macos.sign.passphrase>
        <athene.windows.sign.key></athene.windows.sign.key>
        <athene.windows.sign.passphrase></athene.windows.sign.passphrase>
    </properties>

    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>${mcp.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sshtools</groupId>
            <artifactId>maverick-synergy-client</artifactId>
            <version>${maverick.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sshtools</groupId>
            <artifactId>sshteam-lib</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.sshtools</groupId>
            <artifactId>jadaptive-hsm</artifactId>
            <version>0.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.jadaptive</groupId>
                    <artifactId>athene-maven-plugin</artifactId>
                    <version>0.9.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            
            <!-- Get a full version number given the POM and BUILD_NUMBER -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>build-number-property</id>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <phase>initialize</phase>
                        <configuration>
                            <name>product.version</name>
                            <value>${project.version}</value>
                            <regex>^([0-9]+)\.([0-9]+)\.([0-9]+)-([0-9A-Za-z]+)$</regex>
                            <replacement>$1.$2.$3</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.jadaptive.mcp.MaverickMcpApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.2</version>
                <dependencies>
                    <dependency>
                        <groupId>info.picocli</groupId>
                        <artifactId>picocli-codegen</artifactId>
                        <version>${picocli.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <mainClass>com.jadaptive.mcp.MaverickMcpApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-man-pages</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>
                                picocli.codegen.docgen.manpage.ManPageGenerator</mainClass>
                            <classpathScope>compile</classpathScope>
                            <includePluginDependencies>true</includePluginDependencies>
                            <arguments>
                                <argument>-d</argument>
                                <argument>
                                    ${project.build.directory}/generated-manpages/asciidoc</argument>
                                <argument>
                                    com.jadaptive.mcp.MaverickMcpApplication</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>gzip-man-pages</id>
                        <phase>package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.jadaptive.mcp.build.GzipManPages</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>
                                    ${project.build.directory}/generated-manpages/man1</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>render-man-pages</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <backend>manpage</backend>
                            <sourceDirectory>
                                ${project.build.directory}/generated-manpages/asciidoc</sourceDirectory>
                            <outputDirectory>
                                ${project.build.directory}/generated-manpages/man1</outputDirectory>
                            <preserveDirectories>false</preserveDirectories>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native-image</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <metadataRepository>
                                <enabled>true</enabled>
                            </metadataRepository>
                            <imageName>maverick-ssh-mcp</imageName>
                            <mainClass>com.jadaptive.mcp.MaverickMcpApplication</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-march=compatibility</buildArg>
                                <buildArg>-H:+SharedArenaSupport</buildArg>
                                <buildArg>--enable-all-security-services</buildArg>
                                <buildArg>-H:AdditionalSecurityProviders=org.bouncycastle.jce.provider.BouncyCastleProvider</buildArg>
                                <buildArg>--initialize-at-run-time=org.bouncycastle</buildArg>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <buildArg>--enable-url-protocols=http,https</buildArg>
                                <buildArg>--initialize-at-build-time=com.sshtools.common.files.nio.AbstractFileNIOProvider</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>compile</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>linux-packages</id>
            <activation>
                <os>
                    <family>linux</family>
                </os>
            </activation>
            <properties>
                <build.os>linux</build.os>
            </properties>
            
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <configuration>
                            <buildArgs combine.children="append">
                                <buildArg>-H:+StaticExecutableWithDynamicLibC</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-package-media</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir
                                            dir="${project.build.directory}/media" />
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>prepare-deb-control</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <delimiters>
                                        <delimiter>[[*]]</delimiter>
                                    </delimiters>
                                    <outputDirectory>
                                        ${project.build.directory}/control</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/deb/control</directory>
                                            <filtering>true</filtering>
                                            <includes>
                                                <include>**/*</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                        <version>1.14</version>
                        <executions>
                            <execution>
                                <id>maverick-mcp-deb</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <changesOut>${project.build.directory}/media/maverick-ssh-mcp-${build.os}_${product.version}-${build.number}_${build.arch.deb}.changes</changesOut>
                                    <verbose>true</verbose>
                                    <attach>true</attach>
                                    <skipPOMs>false</skipPOMs>
                                    <installDir>/usr</installDir>
                                    <controlDir>${project.build.directory}/control</controlDir>
                                    <deb>${project.build.directory}/media/maverick-ssh-mcp-${build.os}_${product.version}-${build.number}_${build.arch.deb}.deb</deb>
                                    <dataSet>
                                        <data>
                                            <type>file</type>
                                            <src>${project.build.directory}/maverick-ssh-mcp</src>
                                            <mapper>
                                                <type>perm</type>
                                                <strip>1</strip>
                                                <prefix>/usr/bin</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>755</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <type>directory</type>
                                            <src>${project.build.directory}/generated-manpages/man1</src>
                                            <includes>*.1.gz</includes>
                                            <mapper>
                                                <type>perm</type>
                                                <strip>1</strip>
                                                <prefix>/usr/share/man/man1</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>rpm-maven-plugin</artifactId>
                        <version>2.3.0</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>maverick-ssh-mcp-rpm</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>rpm</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>maverick-ssh-mcp</name>
                            <group>Application/Internet</group>
                            <packager>JADAPTIVE</packager>
                            <license>Commercial</license>
                            <release>${build.number}</release>
                            <!-- Force unsigned RPM output; Athene import/signing handles signatures later. -->
                            <keyname></keyname>
                            <keyPassphrase></keyPassphrase>
                            <prefix>/usr</prefix>
                            <defineStatements>
                                <defineStatement>_signature none</defineStatement>
                                <defineStatement>_gpg_name %{nil}</defineStatement>
                            </defineStatements>
                            <needarch>${build.arch.rpm}</needarch>
                            <postinstallScriptlet>
                                <scriptFile>src/main/rpm/postinstall.sh</scriptFile>
                                <fileEncoding>utf-8</fileEncoding>
                            </postinstallScriptlet>
                            <preremoveScriptlet>
                                <scriptFile>src/main/rpm/preuninstall.sh</scriptFile>
                                <fileEncoding>utf-8</fileEncoding>
                            </preremoveScriptlet>
                            <mappings>
                                <mapping>
                                    <directory>/usr/bin</directory>
                                    <directoryIncluded>false</directoryIncluded>
                                    <filemode>755</filemode>
                                    <username>root</username>
                                    <groupname>root</groupname>
                                    <sources>
                                        <source>
                                            <location>${project.build.directory}/maverick-ssh-mcp</location>
                                        </source>
                                    </sources>
                                </mapping>
                                <mapping>
                                    <directory>/usr/share/man/man1</directory>
                                    <directoryIncluded>false</directoryIncluded>
                                    <filemode>644</filemode>
                                    <username>root</username>
                                    <groupname>root</groupname>
                                    <sources>
                                        <source>
                                            <location>${project.build.directory}/generated-manpages/man1</location>
                                            <includes>
                                                <include>*.1.gz</include>
                                            </includes>
                                        </source>
                                    </sources>
                                </mapping>
                            </mappings>
                        </configuration>
                    </plugin>
                    
                    <plugin>
                        <groupId>com.jadaptive</groupId>
                        <artifactId>athene-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>linux-deploy-maverick-mcp-exe</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>import</goal>
                                </goals>
                                <configuration>
                                    <api>${athene.api}</api>
                                    <repository>${athene.repo}</repository>
                                    <type>files</type>
                                    <serverId>${athene.serverId}</serverId>
                                    <attached>false</attached>
                                    <verbose>true</verbose>
                                    <files>
                                        <file>${project.build.directory}/maverick-ssh-mcp</file>
                                    </files>
                                    <options>
                                        <os>LINUX</os>
                                        <architecture>${build.arch.deb}</architecture>
                                        <package>maverick-ssh-mcp</package>
                                        <version>${product.version}.${build.number}</version>
                                        <extension></extension>
                                    </options>
                                </configuration>
                            </execution>
                            <execution>
                                <id>linux-deploy-maverick-mcp-deb</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>import</goal>
                                </goals>
                                <configuration>
                                    <api>${athene.api}</api>
                                    <repository>${athene.repo}</repository>
                                    <type>debian</type>
                                    <serverId>${athene.serverId}</serverId>
                                    <attached>false</attached>
                                    <verbose>true</verbose>
                                    <files>
                                        <file>${project.build.directory}/media/maverick-ssh-mcp-${build.os}_${product.version}-${build.number}_${build.arch.deb}.deb</file>
                                    </files>
                                    <options>
                                        <section>network</section>
                                    </options>
                                </configuration>
                            </execution>
                            <execution>
                                <id>linux-deploy-maverick-mcp-rpm</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>import</goal>
                                </goals>
                                <configuration>
                                    <api>${athene.api}</api>
                                    <repository>${athene.repo}</repository>
                                    <type>rpm</type>
                                    <serverId>${athene.serverId}</serverId>
                                    <attached>false</attached>
                                    <verbose>true</verbose>
                                    <files>
                                        <file>${project.build.directory}/rpm/maverick-ssh-mcp/RPMS/${build.arch.rpm}/maverick-ssh-mcp-${product.version}-${build.number}.${build.arch.rpm}.rpm</file>
                                    </files>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>windows-package</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.jadaptive</groupId>
                        <artifactId>athene-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>windows-sign-maverick-mcp-native</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>import</goal>
                                </goals>
                                <configuration>
                                    <api>${athene.api}</api>
                                    <repository>${athene.repo}</repository>
                                    <type>files</type>
                                    <serverId>${athene.serverId}</serverId>
                                    <attached>false</attached>
                                    <verbose>true</verbose>
                                    <files>
                                        <file>${project.build.directory}/maverick-ssh-mcp.exe</file>
                                    </files>
                                    <options>
                                        <os>WINDOWS</os>
                                        <architecture>AMD64</architecture>
                                        <package>maverick-ssh-mcp</package>
                                        <version>${product.version}</version>
                                        <extension>.exe</extension>
                                        
                                        <!-- TODO Temporary until JDK crash on Athene is fixed -->
                                      <!--  <key>${athene.windows.sign.key}</key>
                                        <passphrase>${athene.windows.sign.passphrase}</passphrase>-->
                                    </options>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>


        <profile>
            <id>macos-packages</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <build.os>macos</build.os>
            </properties>
            <build>
                <plugins>

                    <!-- Sign the executable -->

                    <plugin>
                        <groupId>com.jadaptive</groupId>
                        <artifactId>athene-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>macos-sign-maverick-mcp-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <api>${athene.api}</api>
                                    <type>apple-codesign</type>
                                    <serverId>${athene.serverId}</serverId>
                                    <file>${project.build.directory}/maverick-ssh-mcp</file>
                                    <outputFile>${project.build.directory}/maverick-ssh-mcp</outputFile>
                                    <options>
                                        <key>${athene.macos.sign.key}</key>
                                        <passphrase>${athene.macos.sign.passphrase}</passphrase>
                                        <codeSignatureFlags>runtime</codeSignatureFlags>
                                    </options>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Build a .pkg -->

                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-macos-pkg-root</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir
                                            dir="${project.build.directory}/media" />
                                        <mkdir
                                            dir="${project.build.directory}/macos-root/Contents/MacOS" />
                                        <copy
                                            file="${project.build.directory}/maverick-ssh-mcp"
                                            tofile="${project.build.directory}/macos-root/Contents/MacOS/maverick-ssh-mcp"
                                            overwrite="true" />
                                        <setpermissions mode="755">
                                            <file
                                                file="${project.build.directory}/macos-root/Contents/MacOS/maverick-ssh-mcp" />
                                        </setpermissions>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>maverick-ssh-mcp-cli-macos-pkg</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>pkgbuild</executable>
                                    <arguments>
                                        <argument>--root</argument>
                                        <argument>${project.build.directory}/macos-root</argument>
                                        <argument>--identifier</argument>
                                        <argument>com.jadaptive.maverick.sshmcp</argument>
                                        <argument>--version</argument>
                                        <argument>${product.version}.${build.number}</argument>
                                        <argument>--install-location</argument>
                                        <argument>/Applications/MaverickSSHMCP.app/</argument>
                                        <argument>${project.build.directory}/media/maverick-ssh-mcp-${build.os}_${product.version}-${build.number}.pkg</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    
                    <plugin>
                        <groupId>com.jadaptive</groupId>
                        <artifactId>athene-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>macos-deploy-maverick-mcp-exe</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>import</goal>
                                </goals>
                                <configuration>
                                    <api>${athene.api}</api>
                                    <repository>${athene.repo}</repository>
                                    <type>files</type>
                                    <serverId>${athene.serverId}</serverId>
                                    <attached>false</attached>
                                    <verbose>true</verbose>
                                    <files>
                                        <file>${project.build.directory}/maverick-ssh-mcp</file>
                                    </files>
                                    <options>
                                        <os>MACOS</os>
                                        <architecture>${build.arch.pkg}</architecture>
                                        <package>maverick-ssh-mcp</package>
                                        <version>${product.version}.${build.number}</version>
                                        <extension>pkg</extension>
                                        <key>${athene.macos.sign.key}</key>
                                        <passphrase>${athene.macos.sign.passphrase}</passphrase>
                                    </options>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>amd64-packages</id>
            <activation>
                <os>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <build.arch.deb>amd64</build.arch.deb>
                <build.arch.rpm>x86_64</build.arch.rpm>
                <build.arch.pkg>amd64</build.arch.pkg>
            </properties>
        </profile>

        <profile>
            <id>arm64-packages</id>
            <activation>
                <os>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <build.arch.deb>arm64</build.arch.deb>
                <build.arch.rpm>aarch64</build.arch.rpm>
                <build.arch.pkg>aarch64</build.arch.pkg>
            </properties>
        </profile>

    </profiles>

    <pluginRepositories>
        <pluginRepository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
