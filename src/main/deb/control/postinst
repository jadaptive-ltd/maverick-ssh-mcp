#!/bin/sh
# postinst script for maverick-ssh-mcp

set -e

case "$1" in
    configure)
        command -v maverick-ssh-mcp >/dev/null 2>&1 || true
    ;;

    triggered|abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
